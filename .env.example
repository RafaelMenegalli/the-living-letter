# Copy to `.env` (or set these in your static host's build settings).
# Every value is optional: the site builds and works with none of them set.

# Public URL the site is deployed at, without a trailing slash.
# Used only to write absolute canonical / social-preview metadata at build time.
# VITE_SITE_URL=https://letters.example.org

# Optional, discreet sponsor line (off unless all three are set).
# See "Optional monetization" in the README before enabling.
# VITE_SPONSOR_NAME=
# VITE_SPONSOR_URL=
# VITE_SPONSOR_TEXT=
